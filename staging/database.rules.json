{
  "rules": {
    ".read": false,
    ".write": false,
    "stagingControl": {
      ".read": false,
      ".write": false
    },
    "lists": {
      "$list": {
        ".read": "root.child('stagingControl/enabled').val() === true && root.child('stagingControl/expiresAt').isNumber() && now < root.child('stagingControl/expiresAt').val() && $list.length > 0 && $list.length <= 768 && $list !== 'new'",
        "$item": {
          ".write": "root.child('stagingControl/enabled').val() === true && root.child('stagingControl/expiresAt').isNumber() && now < root.child('stagingControl/expiresAt').val() && $list.length > 0 && $list.length <= 768 && $list !== 'new' && root.child('listClaims').child($list).val() === true && $item.matches(/^([a-f0-9]{32}|[0-9]{1,10})$/)",
          ".validate": "newData.hasChildren(['ID','name','checked']) && (newData.getPriority() === null || (newData.getPriority() >= -1000000000000 && newData.getPriority() <= 1000000000000))",
          "ID": {
            ".validate": "(newData.isString() || newData.isNumber()) && newData.val()+'' === $item && (!data.exists() || newData.val() === data.val()) && newData.getPriority() === null"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000 && newData.val().matches(/.*[^ ].*/) && newData.getPriority() === null"
          },
          "checked": {
            ".validate": "newData.isBoolean() && newData.getPriority() === null"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "listAttrs": {
      "$list": {
        ".read": "root.child('stagingControl/enabled').val() === true && root.child('stagingControl/expiresAt').isNumber() && now < root.child('stagingControl/expiresAt').val() && $list.length > 0 && $list.length <= 768 && $list !== 'new'",
        "listName": {
          ".write": "root.child('stagingControl/enabled').val() === true && root.child('stagingControl/expiresAt').isNumber() && now < root.child('stagingControl/expiresAt').val() && $list.length > 0 && $list.length <= 768 && $list !== 'new' && root.child('listClaims').child($list).val() === true",
          ".validate": "newData.isString() && newData.val().length <= 160 && newData.getPriority() === null"
        },
        "lastMod": {
          ".write": "root.child('stagingControl/enabled').val() === true && root.child('stagingControl/expiresAt').isNumber() && now < root.child('stagingControl/expiresAt').val() && $list.length > 0 && $list.length <= 768 && $list !== 'new' && root.child('listClaims').child($list).val() === true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now / 1000 + 300 && (!data.exists() || newData.val() >= data.val()) && newData.getPriority() === null"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "listClaims": {
      "$list": {
        ".read": "root.child('stagingControl/enabled').val() === true && root.child('stagingControl/expiresAt').isNumber() && now < root.child('stagingControl/expiresAt').val() && $list.length > 0 && $list.length <= 768 && $list !== 'new'",
        ".write": "root.child('stagingControl/enabled').val() === true && root.child('stagingControl/expiresAt').isNumber() && now < root.child('stagingControl/expiresAt').val() && $list.length > 0 && $list.length <= 768 && $list !== 'new' && !data.exists() && newData.val() === true"
      }
    }
  }
}
